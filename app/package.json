{
  "name": "app",
  "license": "MIT",
  "private": true,
  "version": "0.1.95",
  "type": "module",
  "scripts": {
    "build": "bun -e \"const fs=require('fs'),p='node_modules/vite/bin/vite.js';process.exit(Bun.spawnSync([process.execPath,'--bun',fs.existsSync(p)?p:'../'+p,'build'],{stdio:['inherit','inherit','inherit']}).exitCode)\"",
    "dev": "bun -e \"const fs=require('fs'),p='node_modules/vite/bin/vite.js';process.exit(Bun.spawnSync([process.execPath,'--bun',fs.existsSync(p)?p:'../'+p],{stdio:['inherit','inherit','inherit']}).exitCode)\"",
    "serve": "bun scripts/serve-or-build.ts && bun serve.ts",
    "prebuild": "bun run --cwd .. generate:app-config",
    "predev": "bun run --cwd .. generate:app-config",
    "pretypecheck": "bun run --cwd .. generate:app-config",
    "typecheck": "bun x tsc --noEmit"
  },
  "dependencies": {
    "@ag-ui/core": "1.0.1",
    "@base-ui/react": "^1.6.0",
    "@copilotkit/react-core": "1.77.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@jitl/quickjs-wasmfile-release-sync": "0.32.0",
    "@json-render/core": "0.21.0",
    "@json-render/react": "0.21.0",
    "@shadcn/react": "^0.3.0",
    "@tabler/icons-react": "^3.36.1",
    "@tanstack/react-form": "^1.33.5",
    "@tanstack/react-hotkeys": "^0.10.0",
    "@tanstack/react-query": "^5.101.4",
    "@tanstack/react-router": "^1.170.27",
    "better-auth": "^1.6.27",
    "boring-avatars": "^2.0.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "docx-preview": "0.4.1",
    "embla-carousel-react": "^8.6.0",
    "motion": "^13.1.0",
    "prompt-area": "^0.6.8",
    "quickjs-emscripten": "0.32.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-use-measure": "^2.1.7",
    "shadcn": "^4.17.0",
    "streamdown": "^2.5.0",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
