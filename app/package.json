    "@happy-dom/global-registrator": "^21.0.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/router-plugin": "^1.168.30",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.4",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.4",
    "happy-dom": "^21.0.4",
    "tailwindcss": "^4.3.3",
    "vite": "^7.1.12"
  }
}
