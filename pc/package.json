{
  "name": "chisabot-pc",
  "productName": "ChisaBot PC",
  "version": "0.1.28",
  "description": "ChisaBot PC 客户端：远程聊天 + 让机器人在授权范围内操作这台电脑",
  "main": "src/main.js",
  "author": "ChisaBot",
  "license": "MIT",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node scripts/shell-fingerprint.js --check && node --test test/*.check.js",
    "agent": "node src/cli.js",
    "dist:win": "node scripts/shell-fingerprint.js --write && electron-builder --win nsis zip --x64 && node scripts/shell-fingerprint.js --stamp dist/latest.yml",
    "dist:dir": "node scripts/shell-fingerprint.js --write && electron-builder --win dir --x64",
    "fingerprint": "node scripts/shell-fingerprint.js --write"
  },
  "dependencies": {
    "electron-updater": "6.8.9",
    "ws": "8.22.0"
  },
  "devDependencies": {
    "electron": "44.7.0",
    "electron-builder": "26.15.3"
  },
  "build": {
    "appId": "cn.ayase.chisabot.pc",
    "productName": "ChisaBot PC",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "build/icons",
        "to": "icons",
        "filter": [
          "*.ico"
        ]
      }
    ],
    "win": {
      "target": [
        "nsis",
        "zip"
      ],
      "icon": "build/icon.ico",
      "signAndEditExecutable": true,
      "executableName": "ChisaBotPC",
      "artifactName": "ChisaBot-PC-${version}-${arch}-portable.${ext}",
      "signExecutable": false,
      "verifyUpdateCodeSignature": false
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "ChisaBot PC",
      "language": "2052",
      "installerLanguages": [
        "zh_CN"
      ],
      "unicode": true,
      "include": "build/installer.nsh",
      "artifactName": "ChisaBot-PC-${version}-${arch}-setup.${ext}"
    },
    "electronLanguages": [
      "zh-CN",
      "en-US"
    ],
    "publish": [
      {
        "provider": "generic",
        "url": "https://chisabot.example.com/downloads/chisabot-pc/",
        "channel": "latest"
      }
    ]
  }
}
