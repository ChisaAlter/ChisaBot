# Build context hygiene. Without this the whole tree ships to the daemon, including every
# node_modules and every local artifact, which is slow and puts a developer's .env in an image.
node_modules
**/node_modules
.git
.env
.env.*
!.env.example
dist
**/dist
app/dist
.nx
*.log
.DS_Store
assets/*.svg
work
**/.runtime
.data
deploy/.env
deploy/private
deploy/magpie-data
deploy/public/auth/config.json
deploy/public/auth-data
deploy/public/admin.htpasswd
deploy/public/magpie-private.conf
deploy/public/backup*
deploy/**/id_rsa*
deploy/**/*.key
deploy/**/*.pem
deploy/**/*.sqlite*

# The self-hosted Dockerfile consumes a prebuilt frontend; Git still ignores it.
!app/dist/
!app/dist/**
