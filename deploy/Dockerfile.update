# Incremental upgrade from a verified existing deployment image with matching dependencies.
ARG BASE_IMAGE=local/chisabot:latest
FROM ${BASE_IMAGE}
USER root
RUN rm -rf /app/app/dist /app/server/src /app/server/drizzle /app/server/scripts /app/shared /app/runtime/dsh/src /app/deploy/dsh
COPY --chown=apiuser:apiuser app/dist /app/app/dist
COPY --chown=apiuser:apiuser server /app/server
COPY --chown=apiuser:apiuser shared /app/shared
COPY --chown=apiuser:apiuser runtime/dsh/src /app/runtime/dsh/src
COPY --chown=apiuser:apiuser runtime/dsh/package.json runtime/dsh/package-lock.json /app/runtime/dsh/
COPY --chown=apiuser:apiuser deploy/dsh /app/deploy/dsh
RUN node /app/deploy/dsh/compatibility.mjs --print > /app/deploy/dsh/runtime-compat.json
# Keep the computer process in step with the server cancellation protocol.
RUN rm -rf /app/agent-computer/src
COPY --chown=apiuser:apiuser agent-computer/src /app/agent-computer/src
COPY --chown=apiuser:apiuser pc/src/agent-runtime /app/pc/src/agent-runtime
COPY --chown=apiuser:apiuser server/package.json /app/server/package.json
COPY --chown=apiuser:apiuser bun.lock /app/bun.lock
RUN cd /app/server && bun -e 'await import("@ag-ui/client"); await import("../runtime/dsh/src/client.mjs"); await import("@ai-sdk/openai"); await import("@ai-sdk/anthropic"); await import("./src/model-settings.ts"); console.log("model_settings_runtime_import_ok")'
LABEL chisabot.model-settings="web"
LABEL org.opencontainers.image.title="ChisaBot"
