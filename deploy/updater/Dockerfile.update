# 一键更新的镜像（deploy/updater/update.sh 生成上下文后替换 @…@）。
# 压平的底座只有 1 层，这里固定加几层，永远碰不到 127 层上限。底座的 ENV/入口在压平时丢了，照抄回来。
FROM @BASE_IMAGE@
ENV PATH=/usr/local/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin \
    BUN_INSTALL=/usr/local \
    DEBIAN_FRONTEND=noninteractive \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    APP_DIST_DIR=/app/app/dist \
    WORKSPACE_DIR=/workspace \
    PROFILES_DIR=/profiles \
    AGENT_COMPUTER_URL=http://127.0.0.1:4100 \
    EMBEDDED_POSTGRES=off \
    DATABASE_URL=postgres://openbot@127.0.0.1:5432/openbot \
    NODE_ENV=production \
    PORT=3001 \
    TENANT_PACKAGE_DIR=../examples/zh-CN
USER root
WORKDIR /app
EXPOSE 3001
ENTRYPOINT ["/init"]
HEALTHCHECK --interval=10s --timeout=5s --start-period=30s --retries=5 CMD bun -e "const r = await fetch('http://127.0.0.1:3001/health'); process.exit(r.ok ? 0 : 1)"
RUN rm -rf /app/app/dist /app/server/src /app/server/drizzle /app/server/scripts /app/shared /app/examples/zh-CN /app/agent-computer/src
COPY --chown=apiuser:apiuser app/dist /app/app/dist
COPY --chown=apiuser:apiuser server /app/server
COPY --chown=apiuser:apiuser shared /app/shared
COPY --chown=apiuser:apiuser examples/zh-CN /app/examples/zh-CN
# 服务器直接 import agent-computer/src/egress.ts（网络策略同一份代码），计算机服务也从这里跑：和代码层一起换。
COPY --chown=apiuser:apiuser agent-computer/src /app/agent-computer/src
COPY --chown=apiuser:apiuser build-info.json /app/build-info.json
LABEL org.opencontainers.image.title=ChisaBot \
      org.opencontainers.image.revision=@COMMIT@ \
      org.opencontainers.image.version=@VERSION@ \
      chisabot.locale=zh-CN \
      chisabot.commit=@COMMIT@ \
      chisabot.build=@TAG@ \
      chisabot.base=@BASE_IMAGE@ \
      chisabot.online-update=1
