# /opt/chisabot-updater/config.env：deploy/install-updater.sh 首次安装时按这份部署生成（COMPOSE_DIR、PUBLIC_HEALTH_URL、
# GITHUB_REPO、FULL_BUILD_MEMORY），之后不再覆盖（只会把示例域名的 PUBLIC_HEALTH_URL 改成真实的）；需要时手动改。
COMPOSE_DIR=/opt/openbot-zh
COMPOSE_FILE=compose.yaml
PROJECT=openbot-zh
SERVICE=openbot
CONTAINER=openbot-zh
IMAGE_REPO=local/chisabot
# 快速更新（只替换代码层）用的底座和依赖树。第一次「一键完整更新」成功后由 update.sh 写进 base.env 并覆盖这两项，
# 一般不用改；全新安装留着默认值即可（找不到底座时自动走完整构建）。
BASE_IMAGE=local/chisabot:flat-base
NODE_MODULES_BASE=/opt/chisabot-updater/node_modules-base
# 构建期间暂停的容器（空格分隔，可留空），结束后恢复；小内存机器上用来腾内存。
PROTO_CONTAINERS=""
# 快速更新里前端构建容器的内存上限。
BUILD_MEMORY=3500m
# 完整构建（docker buildx 构建器 chisabot-builder）的内存上限，不含 swap；4 GB 内存的机器设 3g 并加 swap。
# 改了之后下次完整构建自动重建构建器（层缓存清空）。
FULL_BUILD_MEMORY=6g
# 完整构建同时跑的步骤数（冷缓存时 apt / bun install / vite 会并行）；内存紧就设 1。
FULL_BUILD_PARALLELISM=2
# 完整构建的层缓存上限（docker buildx prune --max-used-space）。
BUILD_CACHE_MAX=20gb
LOCAL_URL=http://127.0.0.1:3001
# 公网登录页，健康检查要它返回 200（与 deploy/.env 的 CHISABOT_DOMAIN / CHISABOT_HTTPS_PORT 一致）。
# deploy/install-updater.sh 按 deploy/.env 自动填；留空 = 跳过这项检查（还没配 HTTPS 网关时）。
PUBLIC_HEALTH_URL=
VITE_MAGPIE_MANAGEMENT_URL=
# 拉取新提交的仓库（自己的 fork 就改成自己的 owner/repo）。公开仓库匿名拉取；私有仓库放只读令牌
# /opt/chisabot-updater/github-token，或设 GITHUB_FETCH=off 并由发布者 git push 到本机镜像。
GITHUB_FETCH=auto
GITHUB_REPO=ChisaAlter/ChisaBot
GITHUB_BRANCH=main
KEEP_IMAGES=5
KEEP_BACKUPS=5
