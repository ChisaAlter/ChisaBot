CHISABOT_RUNTIME_MODE=local
SL_ENABLED=false
COPILOTKIT_TELEMETRY_DISABLED=true
DO_NOT_TRACK=1
KEY_ENCRYPTION_KEY=
# 镜像：start.sh 构建 latest；装了在线更新后由 管理后台 → 系统更新 改成 local/chisabot:auto-…（不要手动改回）。
CHISABOT_IMAGE=local/chisabot:latest
# 仓库在宿主机上的路径，deploy/start.sh 自动填（系统更新页的升级命令用）。
CHISABOT_SOURCE_DIR=
MAGPIE_NETWORK=openbot_magpie
BOT_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
ANTHROPIC_API_KEY=
ANTHROPIC_BASE_URL=https://api.anthropic.com
BOT_MODEL=your-model-id
VITE_MAGPIE_MANAGEMENT_URL=
# 内嵌 Magpie 管理（docs/magpie.md）：容器内地址与只读 Web key 文件路径。
MAGPIE_ADMIN_URL=
MAGPIE_WEB_KEY_FILE=
MODEL_CATALOG_REFRESH_MINUTES=10
DEPLOYMENT_ID=chisabot-zh

# ---- 公网入口（deploy/public/render-nginx.sh 读取；见 README「给 AI 的部署引导」）----
# 你的域名（证书在 ${CHISABOT_CERT_DIRECTORY}/live/<CHISABOT_CERT_NAME>/）。
CHISABOT_DOMAIN=
# ChisaBot 入口与 Magpie 管理入口端口。用 Cloudflare 代理（橙色云）时只能选 443、2053、2083、2087、2096、8443。
CHISABOT_HTTPS_PORT=8443
CHISABOT_MAGPIE_PORT=2053
# 证书目录（挂进网关容器的 /etc/letsencrypt）与 live/ 下的目录名（默认等于域名）。
CHISABOT_CERT_DIRECTORY=/etc/letsencrypt
CHISABOT_CERT_NAME=
# 运行 render-nginx.sh 后改成 ./nginx.generated.conf（路径相对 deploy/public/）。
CHISABOT_NGINX_CONF=./nginx.conf
