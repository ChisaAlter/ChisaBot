# Incremental ChisaBot image: the currently running production image plus this tree's prebuilt
# frontend (app/dist), server, shared code and zh-CN tenant package. Dependencies are unchanged
# (same bun.lock as the base), so nothing is reinstalled.
#   docker build -f deploy/Dockerfile.glass --build-arg BASE_IMAGE=local/chisabot-zh:20261010-custom-panels -t local/chisabot:glass .
ARG BASE_IMAGE=local/chisabot-zh:20261010-custom-panels
FROM ${BASE_IMAGE}
USER root
RUN rm -rf /app/app/dist /app/server/src /app/server/drizzle /app/server/scripts /app/shared /app/runtime/dsh/src /app/deploy/dsh
COPY --chown=apiuser:apiuser app/dist /app/app/dist
COPY --chown=apiuser:apiuser server /app/server
COPY --chown=apiuser:apiuser shared /app/shared
COPY --chown=apiuser:apiuser runtime/dsh/src /app/runtime/dsh/src
COPY --chown=apiuser:apiuser runtime/dsh/package.json runtime/dsh/package-lock.json /app/runtime/dsh/
COPY --chown=apiuser:apiuser deploy/dsh /app/deploy/dsh
RUN node /app/deploy/dsh/compatibility.mjs --print > /app/deploy/dsh/runtime-compat.json
# The browser/server and the computer must use the same cancellation protocol.
RUN rm -rf /app/agent-computer/src
COPY --chown=apiuser:apiuser agent-computer/src /app/agent-computer/src
COPY --chown=apiuser:apiuser pc/src/agent-runtime /app/pc/src/agent-runtime
COPY --chown=apiuser:apiuser examples/zh-CN /app/examples/zh-CN
RUN cd /app/server \
    && bun -e 'await import("@ag-ui/client"); await import("../runtime/dsh/src/client.mjs"); await import("./src/panels/routes.ts"); console.log("runtime_and_panels_import_ok")'
ENV TENANT_PACKAGE_DIR=../examples/zh-CN
LABEL chisabot.locale="zh-CN"
LABEL org.opencontainers.image.title="ChisaBot"
LABEL chisabot.ui="glass"
