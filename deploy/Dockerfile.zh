ARG BASE_IMAGE=ghcr.io/copilotkit/openbot@sha256:e3901de8c2b33dbe3eac5a2cfb126168c9c82ac94c0ebf6765515532d6021b62
FROM ${BASE_IMAGE} AS production-deps

USER root
WORKDIR /chisabot-deps
COPY package.json bun.lock ./
COPY app/package.json app/package.json
COPY server/package.json server/package.json
RUN bun install --frozen-lockfile --production --linker hoisted --backend copyfile \
    && mkdir -p server/node_modules \
    && cd server \
    && bun -e 'await import("@copilotkit/runtime/v2"); console.log("runtime_import_ok")'

FROM ${BASE_IMAGE}

USER root
# Match the standalone image's Office-capable Python for the inherited friend image too.
RUN apt-get update && apt-get install -y --no-install-recommends \
      python3 python-is-python3 python3-openpyxl python3-docx \
    && python -c 'import openpyxl, docx' \
    && rm -rf /var/lib/apt/lists/*
RUN rm -rf /app/node_modules /app/server/node_modules
COPY --from=production-deps --chown=apiuser:apiuser /chisabot-deps/node_modules /app/node_modules
COPY --from=production-deps --chown=apiuser:apiuser /chisabot-deps/server/node_modules /app/server/node_modules

COPY --chown=apiuser:apiuser app/dist /app/app/dist
COPY --chown=apiuser:apiuser server /app/server
COPY --chown=apiuser:apiuser shared /app/shared
COPY --chown=apiuser:apiuser examples/zh-CN /app/examples/zh-CN
# 计算机服务（机器人的浏览器 / 接管直播屏）也用本仓库的代码，和 updater 的 Dockerfile.update 一致。
# 以前只换了 app/server，计算机仍是底座镜像里的旧 agent-computer：网页的直播屏协议（keepalive pong、
# 地址栏、标签）它不认识，接管大屏直接显示「That input message has an unknown type.」。
RUN rm -rf /app/agent-computer/src
COPY --chown=apiuser:apiuser agent-computer/src /app/agent-computer/src

RUN cd /app/server \
    && bun -e 'await import("@copilotkit/runtime/v2"); console.log("runtime_import_ok")'

COPY deploy/migrate-wait.sh /etc/s6-overlay/scripts/migrate-wait.sh
RUN chmod 755 /etc/s6-overlay/scripts/migrate-wait.sh \
    && sh -n /etc/s6-overlay/scripts/migrate-wait.sh \
    && test -x /usr/bin/pg_isready \
    && test -x /etc/s6-overlay/scripts/migrate.sh \
    && printf '%s\n' '/command/with-contenv /etc/s6-overlay/scripts/migrate-wait.sh' \
       > /etc/s6-overlay/s6-rc.d/migrate/up
ENV TENANT_PACKAGE_DIR=../examples/zh-CN
ENV CHISABOT_PANEL_COMMANDS=1

# 来源提交（deploy/start.sh 经 compose build args 传入；docs/online-update.md）：GET /api/version 读 build-info.json，
# 宿主机更新服务读 chisabot.commit 标签判断落后多少个提交。工作区有未提交改动时 CHISABOT_COMMIT 为空、不记。放最后，只多一层小文件。
ARG CHISABOT_VERSION=0.0.0
ARG CHISABOT_COMMIT=
ARG CHISABOT_BUILD=dev
ARG CHISABOT_BUILT_AT=
ARG CHISABOT_IMAGE=
RUN printf '{"version":"%s","commit":"%s","buildId":"%s","builtAt":"%s","image":"%s"}\n' \
    "$CHISABOT_VERSION" "$CHISABOT_COMMIT" "$CHISABOT_BUILD" "$CHISABOT_BUILT_AT" "$CHISABOT_IMAGE" > /app/build-info.json \
    && chown apiuser:apiuser /app/build-info.json
LABEL chisabot.commit="${CHISABOT_COMMIT}" \
      chisabot.build="${CHISABOT_BUILD}" \
      org.opencontainers.image.revision="${CHISABOT_COMMIT}"
LABEL chisabot.locale="zh-CN"
LABEL org.opencontainers.image.title="ChisaBot"
