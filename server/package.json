    "@ai-sdk/openai": "3.0.99",
    "@better-auth/drizzle-adapter": "^1.7.1",
    "@composio/core": "^0.18.1",
    "@copilotkit/runtime": "1.77.0",
    "@json-render/core": "0.21.0",
    "@json-render/react": "0.21.0",
    "@mastra/client-js": "^1.43.0",
    "@mastra/core": "^1.64.0",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "better-auth": "^1.7.1",
    "cel-js": "^0.8.2",
    "cron-parser": "^5",
    "drizzle-orm": "^0.45.2",
    "eventsource": "3.0.7",
    "hono": "^4.10.0",
    "postgres": "^3.4.9",
    "rxjs": "7.8.1",
    "twilio": "5.13.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
