  "private": true,
  "version": "0.1.107",
  "type": "module",
  "scripts": {
    "build": "bun x tsc --noEmit",
    "db:generate": "bun --env-file=../.env drizzle-kit generate --config=drizzle.config.ts",
    "db:migrate": "bun --env-file=../.env drizzle-kit migrate --config=drizzle.config.ts",
    "dev": "bun --env-file=../.env --watch src/index.ts",
    "typecheck": "bun x tsc --noEmit"
  },
  "dependencies": {
    "@ag-ui/client": "1.0.1",
    "@ag-ui/core": "1.0.1",
    "@ag-ui/mastra": "1.1.6",
