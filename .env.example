# =============================================================================
# ChisaBot 本地开发与自托管环境变量示例
# -----------------------------------------------------------------------------
# 本地开发：复制为仓库根目录 .env（cp .env.example .env）并按需填写模型密钥。
# 容器部署：请使用 deploy/.env.example 或 deploy/friend.env.example（见 deploy/README.zh-CN.md）。
# 完整说明见 docs/configuration.md。
# =============================================================================

# -----------------------------------------------------------------------------
# 1. 数据库、运行模式与遥测关闭
# -----------------------------------------------------------------------------
DATABASE_URL=postgres://chisabot:chisabot@localhost:5432/chisabot
# 自托管本地运行模式，全部会话与业务数据保存在你自己的 PostgreSQL 中。
CHISABOT_RUNTIME_MODE=local
SL_ENABLED=false
DO_NOT_TRACK=1

# 凭据保险箱对称加密密钥（AES-256-GCM，32 字节 Base64）。
# 下方示例值仅用于本地开发与自动化测试；生产环境检测到该公开默认值将拒绝启动。
# 生成命令：openssl rand -base64 32
KEY_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=

# 审计日志保留天数（不设置则永久保留；审计表仅追加写入）。
# AUDIT_RETENTION_DAYS=365

# -----------------------------------------------------------------------------
# 2. 服务端口、租户包与界面开关
# -----------------------------------------------------------------------------
# API 服务端监听端口（PORT 与 SERVER_PORT 同时设置时必须一致；前端开发代理默认读取 3001）。
PORT=3001
SERVER_PORT=3001
# 租户包目录（定义品牌名称、默认模型、初始机器人、频道与技能，详见 docs/configuration.md）。
TENANT_PACKAGE_DIR=../examples/zh-CN
# 部署实例标识（默认取租户包 id；多实例共用同一租户包时可显式区分）。
# DEPLOYMENT_ID=

# 生成式 UI（json-render Skyglass 受控组件目录，服务端校验，不执行模型编写的脚本；默认开启，设 false 关闭）。
# CHISABOT_GENERATIVE_UI=false
# 允许管理员的实时面板使用本机命令数据源（在服务端宿主机执行命令，默认关闭）。
# CHISABOT_PANEL_COMMANDS=1
# 默认隐藏的高级扩展页（workflows,plugins,boundaries,components 或 all）。
# CHISABOT_EXTRAS=workflows,plugins,boundaries,components

# -----------------------------------------------------------------------------
# 3. 认证网关与安全信任边界（详见 docs/ops/trust-boundary.md 與 docs/accounts.md）
# -----------------------------------------------------------------------------
# 本地免登录单管理员模式：仅限本机回环（loopback）访问时使用！
# 暴露到局域网或公网前，必须前置 HTTPS 登录网关或配置下方 OAuth 登录提供商。
CHISABOT_SINGLE_USER=true
# 允许跨域携带凭据的前端来源（本地 Vite 开发服务器默认在 3010 端口）。
TRUSTED_ORIGINS=http://localhost:3010

# 多账号与前置 ChisaBot 登录网关：填入与网关 config.json 中 identitySecret 相同的随机密钥（≥32 字符）。
# 配置后，本机运维脚本/更新器访问本机管理接口须携带请求头 X-ChisaBot-Local-Caller: <同一密钥>。
# CHISABOT_GATEWAY_SECRET=
# 设置 → 管理 →「账号」入口开关（默认开启，设为 0 或 false 隐藏）。
# CHISABOT_ACCOUNTS_UI=1
# 强制会话 Cookie 启用 Secure 属性（当 CHISABOT_PUBLIC_URL 为 https 时也会自动开启）。
# CHISABOT_SECURE_COOKIES=1

# 可选：Better Auth OAuth 登录（配置任一提供商即启用登录；启用时请关闭无网关公网单用户暴露）
# BETTER_AUTH_URL=http://localhost:3001
# BETTER_AUTH_SECRET=
# INITIAL_ADMIN_EMAILS=admin@example.com
# SIGNIN_ALLOWED_EMAIL_DOMAINS=example.com
# CHISABOT_PUBLIC_URL=https://chisabot.example.com
# CHISABOT_APP_URL=http://localhost:3010
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_CLIENT_ID=
# MICROSOFT_OAUTH_CLIENT_SECRET=
# MICROSOFT_OAUTH_TENANT_ID=common
# OKTA_OAUTH_CLIENT_ID=
# OKTA_OAUTH_CLIENT_SECRET=
# OKTA_OAUTH_ISSUER=https://example.okta.com/oauth2/default

# -----------------------------------------------------------------------------
# 4. DSH 执行内核与会话流守护（详见 docs/ops/dsh-runtime.md）
# -----------------------------------------------------------------------------
# 现役唯一内置执行内核：DSH（独立 Node Host 进程，PostgreSQL 持久化线程/事件，支持工具与审批网关）。
# 本地开发首次运行前请执行：npm ci --prefix runtime/dsh
CHISABOT_AGENT_KERNEL=dsh
CHISABOT_DSH_ROOT=.data/dsh
# 多账号生产部署按账号隔离 DSH Host 时可指定路由表与内部工具网关地址：
# CHISABOT_DSH_TARGETS_FILE=/etc/chisabot/dsh-targets.json
# CHISABOT_DSH_TOOL_GATEWAY_URL=http://127.0.0.1:3001/api/internal/dsh-tools

# 单轮流式响应静默超时（毫秒）：流式输出连续无事件超过该时长则终止本轮并记审计日志（0 表示关闭）。
AGENT_STALL_TIMEOUT_MS=60000

# 机器人委托与自建上限（默认关闭跨机器人自动接力；允许机器人按上限创建子机器人）
# BOT_HANDOFF_MAX_DEPTH=0
# BOT_HANDOFF_MAX_PER_RUN=3
# BOT_FACTORY_MAX_DEPTH=1
# BOT_FACTORY_MAX_PER_USER=20

# 可选：远程自定义 AG-UI 机器人与工具回调鉴权密钥
# MANAGED_AGENT_AG_UI_URL=
# MANAGED_AGENT_TOKEN=
AGENT_TOOL_TOKEN=

# -----------------------------------------------------------------------------
# 5. 模型网关、Magpie 与语音听写（详见 docs/models.md 与 docs/magpie.md）
# -----------------------------------------------------------------------------
# 默认 OpenAI 兼容接口密钥与地址（可直连官方 API，也可指向自建 Magpie 统一模型网关 /v1）
OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_CONTAINER_BASE_URL=

# 其他原生提供商与默认模型配置
# BOT_PROVIDER=openai
# BOT_MODEL=gpt-5.5
# CHISABOT_MODEL_FALLBACKS=
# ANTHROPIC_API_KEY=
# ANTHROPIC_BASE_URL=
# GOOGLE_API_KEY=
# GOOGLE_GENERATIVE_AI_BASE_URL=
# CLAUDE_CODE_OAUTH_TOKEN=
# CHATGPT_AUTH_FILE=
# BOT_RESPONSES_API=false
# BOT_REASONING_EFFORT=

# 内嵌 Magpie 模型网关管理面（服务端代理转发，前端不接触管理密钥）
# MAGPIE_ADMIN_URL=http://magpie:3000
# MAGPIE_WEB_KEY_FILE=/run/secrets/magpie_web_key
# VITE_MAGPIE_MANAGEMENT_URL=
# MODEL_CATALOG_REFRESH_MINUTES=10

# 可选：输入框语音听写（兼容 POST /audio/transcriptions，独立于对话模型配置）
# TRANSCRIPTION_PROVIDER=openai-compatible
# TRANSCRIPTION_BASE_URL=https://api.openai.com/v1
# TRANSCRIPTION_MODEL=gpt-transcribe
# TRANSCRIPTION_API_KEY=

# -----------------------------------------------------------------------------
# 6. 云端浏览器与受控计算机（agent-computer）
# -----------------------------------------------------------------------------
# 云端浏览器服务地址（留空则关闭云端浏览器能力）与调用鉴权密钥
AGENT_COMPUTER_URL=http://localhost:4100
COMPUTER_TOKEN=

# 仅限本机开发调试时手动取消注释（允许浏览器与远程 Agent 访问本机私有地址；生产环境开启会拒绝启动！）
# AGENT_COMPUTER_ALLOW_PRIVATE_HOSTS=true
# 生产环境如需允许特定内网 Agent 地址，请按精确主机名/端口白名单逐项声明：
# AGENT_ENDPOINT_ALLOWED_HOSTS=agents.internal,10.0.0.42:9000

# 计算机动作策略（deny 优先于 allow；下方示例拦截表单提交点击与回车键提交）
# AGENT_COMPUTER_POLICY={"mode":"enforce","deny":["(intent == \"activate\" && contains(element.name, \"submit\")) || ((tool.name == \"computer_key\" || tool.name == \"computer_type\") && key == \"Enter\")"],"allow":["true"]}
# ACTION_TIMEOUT_MS=10000
# COMPUTER_SHELL_ENV=JAVA_HOME,GOPATH
# PROFILES_DIR=/profiles
# COMPUTER_BROWSER_BACKEND=managed
# COMPUTER_BROWSER_MODE=headed
# CHISABOT_LOCAL_COMPUTER_DIR=
# COMPUTER_BOT_ID=shared
# 容器运行时（宿主机支持 gVisor 时可设为 runsc）
COMPUTER_RUNTIME=

# -----------------------------------------------------------------------------
# 7. 第三方应用连接器与入站邮件触发（可选）
# -----------------------------------------------------------------------------
# Composio 托管 OAuth 连接器密钥（不填则不启用托管第三方应用目录）
COMPOSIO_API_KEY=

# 入站邮件触发器（Amazon SES -> SNS -> /api/events/email/sns）
# CHISABOT_INBOUND_EMAIL_DOMAIN=in.example.com
# CHISABOT_INBOUND_EMAIL_SNS_TOPIC_ARNS=arn:aws:sns:us-east-1:123456789012:chisabot-inbound
